# ==========================================
# Terraform State & Local Configurations
# ==========================================
# Local .terraform directories (contains provider plugins and modules)
.terraform/

# Hide local CLI history logs
.terraform.lock.hcl

# Main state files and state backups
*.tfstate
*.tfstate.*

# Crash logs generated by Terraform
crash.log
crash.*.log

# ==========================================
# Variables and Secrets (CRITICAL)
# ==========================================
# Ignore all local variable files containing passwords, keys, or secret tokens
*.tfvars
*.tfvars.json

# Ignore local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================
# Security Keys & Certificates
# ==========================================
# Prevent your private SSH access keys from ever being uploaded to GitHub
*.pem
*.key
*.pub

# ==========================================
# System & Editor Files
# ==========================================
# MacOS system files
.DS_Store

# IDE / Text Editor directories
.idea/
.vscode/
*.swp
*.swo

# ==============================================================================
# Terragrunt Specifics
# ==============================================================================
# Terragrunt caching directory where modules are downloaded
.terragrunt-cache/
**/.terragrunt-cache/*

# Terragrunt Stacks directory (if using Terragrunt Stacks)
.terragrunt-stack/

# Generated debug files
terragrunt-debug.tfvars.json

# ==============================================================================
# Terraform / OpenTofu Specifics
# ==============================================================================
# Local directory for managing plugins and modules
.terraform/

# Local state files (Remote state should be used via backend configurations)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files if they contain secrets or local overrides
# (Omit this line if your tfvars are non-sensitive and intentionally tracked)
*.tfvars
*.tfvars.json

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration file
.terraformrc
terraform.rc

# ==============================================================================
# Optional: IDE and OS files
# ==============================================================================
.DS_Store
.idea/
.vscode/
*.iml

